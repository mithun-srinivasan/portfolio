# Normalise every text file to LF in the repository, regardless of the
# contributor's operating system. Windows checkouts get CRLF in the working
# tree only where core.autocrlf asks for it; committed bytes stay LF.
* text=auto eol=lf

# Binary assets: never text-normalise or diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
